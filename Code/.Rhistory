nuka_df$CASRN == casrn_value)
if (!duplicate_exists) {
# Add new row to NUKA using the same structure as existing data
new_row <- nuka_df[1, ]  # Copy structure
new_row$PREFERRED_NAME <- compound_name
new_row$CASRN <- casrn_value
# If NUKA is empty, create first row differently
