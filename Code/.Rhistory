tcltk::tkpack(ok_button, side = "left", padx = 5)
tcltk::tkpack(skip_button, side = "right", padx = 5)
tcltk::tkwait.window(tt)
if (saved) {
cat(paste("CASRN added for", compound_name, "\n"))
}
}
return(result_df)
}
