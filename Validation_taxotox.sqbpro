    t.exposure_type,
    r.endpoint,
    r.trend,
    r.effect,
    r.conc1_unit,
    r.conc1_mean,
    r.conc2_mean,
    r.conc3_mean,
    r.conc1_min,
    r.conc1_max,
    s.species,
    s.ecotox_group,
    c.chemical_name,
    c.cas_number

FROM results r
JOIN tests t ON r.test_id = t.test_id
JOIN species s ON t.species_number = s.species_number
JOIN chemicals c ON t.test_cas = c.cas_number
WHERE c.cas_number = 122521  -- Replace with your specific CAS number</sql><current_tab id="0"/></tab_sql></sqlb_project>
